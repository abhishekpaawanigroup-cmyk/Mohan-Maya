# YouTube Data API v3 -get a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Instagram Reels (via Apify) - OPTIONAL. If unset, the reels endpoint reports
# "not configured" and the site works normally. Configure on your host only.
# Simplest (recommended): paste your ready Apify API URL with the token embedded
# - the backend just GETs it and normalises the items:
# INSTAGRAM=https://api.apify.com/v2/datasets/XXXX/items?token=YYYY
# --- OR --- use a bare token + actor/username instead:
# INSTAGRAM_API_KEY=your_apify_token   # (or APIFY_TOKEN)
# INSTAGRAM_USERNAME=mohanmaya_
# INSTAGRAM_APIFY_ACTOR=apify~instagram-reel-scraper

# Optional
# PORT=5000
# NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
# CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
